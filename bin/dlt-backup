#!/usr/bin/env bash

set -euo pipefail

_bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly _bin_dir

if [ -f "$_bin_dir/../libexec/backup.sh" ]; then
    app_dir="$(dirname "$_bin_dir")"
else
    app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/dlt/backup"
fi

libexec_dir="$app_dir/libexec"

usage() {
    local prog="${0##*/}"
    echo "Usage: $prog [OPTIONS]"
    echo "       $prog config"
    echo "       $prog list"
    echo "       $prog info"
    echo "       $prog snapshot TARGET_DIR PREFIX"
    echo
    echo "Backup configured source directories."
    echo
    echo "Commands:"
    echo "  config                  Manage backup configuration"
    echo "  list                    List backup archives"
    echo "  info                    Show repository information"
    echo "  snapshot                Produce a snapshot of the latest backup"
    echo
    echo "Arguments:"
    echo "  TARGET_DIR              Target directory used to store the snapshot"
    echo "  PREFIX                  Filename prefix, to be followed by the archive name"
    echo
    echo "Options:"
    echo "  -h, --help              Show this help message"
    echo "  -n, --notify            Show a toaster notification when complete"
    echo "  -o, --notify-once-daily Only show the first toaster notification of the day"
    exit 2
}

case ${1:-} in
    --help|-h)
        usage
        ;;
    config)
        shift
        exec "$libexec_dir/config.sh" "$@"
        ;;
    list)
        shift
        exec "$libexec_dir/list.sh" "$@"
        ;;
    info)
        shift
        exec "$libexec_dir/info.sh" "$@"
        ;;
    snapshot)
        shift
        exec "$libexec_dir/snapshot.sh" "$@"
        ;;
    *)
        exec "$libexec_dir/backup.sh" "$@"
        ;;
esac
